# Values compose.yaml reads. init-host.sh writes them to .devcontainer/.env (gitignored) from the
# host; edit that file to change one.

# The repository's directory name: names the compose project, the image and the mount path.
REPO_NAME=agent-control-plane
# The repository owner (`id -u` / `id -g`): the container runs as this user. Use the same values as
# ACP_UID / ACP_GID in the control plane's .env.
HOST_UID=501
HOST_GID=20
TZ=Asia/Tokyo
# Claude Code's config, gh's config and shell history live here, outside Docker.
DEV_STATE_DIR=/Users/you/.local/state/devcontainers/agent-control-plane
