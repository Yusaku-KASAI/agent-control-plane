#!/bin/bash
# Copies the copy source (the directory above this one's parent) into a new target's directory, as
# target-template's new-target procedure tells: without template/, with the .tmpl suffixes removed.
# Usage: copy-target <new repository's directory>
set -euo pipefail

dest=${1:?usage: copy-target <new repository directory>}
src=$(cd "$(dirname "$0")/../.." && pwd)
mkdir -p "$dest"
cp -R "$src/." "$dest/"
rm -r "$dest/template"
find "$dest" -name '*.tmpl' -print0 | while IFS= read -r -d '' f; do
	mv "$f" "${f%.tmpl}"
done
