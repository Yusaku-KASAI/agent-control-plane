#!/bin/bash
# Copies the copy source (two directories above this script's directory) into a new target's
# directory, as target-template's new-target procedure tells: with the .tmpl suffixes removed, and
# with template/'s documents put as put-template puts them. The directory must be empty but for .git,
# so that nothing there is overwritten.
# Usage: copy-target <new repository's directory>
set -euo pipefail

dest=${1:?usage: copy-target <new repository directory>}
src=$(cd "$(dirname "$0")/../.." && pwd)
mkdir -p "$dest"
if [[ -n $(find "$dest" -mindepth 1 -maxdepth 1 ! -name .git -print -quit) ]]; then
	echo "copy-target: $dest has files besides .git; copy into an empty repository" >&2
	exit 1
fi
cp -R "$src/." "$dest/"
"$src/template/bin/put-template" "$dest"
find "$dest" -path "$dest/.git" -prune -o -name '*.tmpl' -print0 | while IFS= read -r -d '' f; do
	mv "$f" "${f%.tmpl}"
done
