#!/bin/bash
# Puts the copy source's template/ documents into a target, replacing what is there: without
# template/bin/, relinked for life outside agent-control-plane, and with template/base recording the
# agent-control-plane commit they come from (only when the copy source has no uncommitted changes,
# since the commit would not hold them). update-target merges from that commit.
# Usage: put-template <target's directory>
set -euo pipefail

dest=${1:?usage: put-template <target directory>}
src=$(cd "$(dirname "$0")/../.." && pwd)
rm -rf "$dest/template"
mkdir -p "$dest/template"
cp -R "$src/template/." "$dest/template/"
rm -r "$dest/template/bin"
"$src/template/bin/relink-template" "$dest"
if git -C "$src" rev-parse --git-dir >/dev/null 2>&1 && [[ -z $(git -C "$src" status --porcelain -- .) ]]; then
	git -C "$src" rev-parse HEAD >"$dest/template/base"
	# Another clone can only find a commit that some remote has.
	if [[ -n $(git -C "$src" remote) && -z $(git -C "$src" branch -r --contains HEAD) ]]; then
		echo "put-template: template/base is $(git -C "$src" rev-parse --short HEAD), which no remote branch has yet; push it" >&2
	fi
else
	echo "put-template: the copy source is not a clean git checkout; template/base is not written" >&2
fi
