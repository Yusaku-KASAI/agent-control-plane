#!/usr/bin/env python3
"""Rewrites a copied target's template/ documents for life outside agent-control-plane.

Links that leave template/ (to the platform or the control plane) would break in the copy, so they
become links to the same files on GitHub at main, where targets also take the platform's actions.
ADR references (amends and the like) that leave template/ have no file to point at, so they are
dropped; the ADR's text still names them.
A link whose file is missing in agent-control-plane fails the copy, since no check of the copy can
follow a link to GitHub.
Usage: relink-template <copied target's directory> <agent-control-plane's path of the copy source>
"""
import os
import re
import sys

REPOSITORY = "https://github.com/Yusaku-KASAI/agent-control-plane/blob/main"
CHECKOUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..")
LINK = re.compile(r"(\]\()([^)\s#]+)((?:#[^)\s]*)?(?:\s+\"[^\"]*\")?\))")
REFERENCE = re.compile(r"^(amends|amended_by|supersedes|superseded_by):\s*\[(.*)\]\s*$", re.M)


def main(dest, source_in_repository):
    template = os.path.join(dest, "template")
    for directory, _, names in os.walk(template):
        for name in names:
            if name.endswith(".md"):
                relink(os.path.join(directory, name), dest, source_in_repository)


def leaves(path, target, dest):
    resolved = os.path.normpath(os.path.join(os.path.dirname(path), target))
    return os.path.relpath(resolved, os.path.join(dest, "template")).startswith(".."), resolved


def relink(path, dest, source_in_repository):
    with open(path, encoding="utf-8") as f:
        text = f.read()

    def link(m):
        target = m.group(2)
        if re.match(r"[a-z][a-z0-9+.-]*:", target):
            return m.group(0)
        outside, resolved = leaves(path, target, dest)
        if not outside:
            return m.group(0)
        inside = os.path.normpath(os.path.join(source_in_repository, os.path.relpath(resolved, dest)))
        if inside.startswith("..") or not os.path.exists(os.path.join(CHECKOUT, inside)):
            sys.exit(f"relink-template: {path}: {target} is not a file of agent-control-plane ({inside})")
        return f"{m.group(1)}{REPOSITORY}/{inside}{m.group(3)}"

    def references(m):
        kept = [item.strip() for item in m.group(2).split(",") if item.strip()]
        kept = [item for item in kept if not (item.startswith('"') and leaves(path, item.strip('"'), dest)[0])]
        return f"{m.group(1)}: [{', '.join(kept)}]" if kept else ""

    if text.startswith("---\n"):
        end = text.index("\n---\n", 4)
        lines = [REFERENCE.sub(references, line) for line in text[:end].split("\n")]
        text = "\n".join(line for line in lines if line) + text[end:]
    text = LINK.sub(link, text)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


if __name__ == "__main__":
    main(*sys.argv[1:3])
