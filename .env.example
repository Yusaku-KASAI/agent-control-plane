# Copy to .env (gitignored) for `docker compose up`.
ACP_API_TOKEN=change-me
ACP_CONFIG=/absolute/path/on/host/to/acp.yaml
# Must contain every target path and sessions.root in acp.yaml.
ACP_HOST_ROOT=/absolute/path/on/host/to/projects
# Must contain every github.private_key_path in acp.yaml. Keep it outside ACP_HOST_ROOT.
ACP_SECRETS_DIR=/absolute/path/on/host/to/acp-secrets
# Host user that owns the session workspaces (`id -u` / `id -g`).
ACP_UID=501
ACP_GID=20
