# Copy to .env (gitignored) for `docker compose up`.

# Bearer token for the control plane API, used by `acp run` / `acp stop` (export it as ACP_API_TOKEN).
ACP_API_TOKEN=change-me
# Host path of the control plane config: acp.yaml copied from acp.example.yaml. Mounted read-only.
ACP_CONFIG=/home/you/projects/agent-control-plane/acp.yaml
# Mounted at the same path in the control plane container (docs/architecture/app/containers.md):
# must contain sessions.root and usage_log in acp.yaml and the directory holding each target beside its
# marketplaces (platform/docs/reference/target.md#host).
ACP_HOST_ROOT=/home/you/projects
# Mounted read-only at the same path: must contain every token and key path in acp.yaml.
# Keep it outside ACP_HOST_ROOT, which the devcontainer can read.
ACP_SECRETS_DIR=/home/you/acp-secrets
# The control plane runs as this user and creates the session workspaces. Agent containers run as
# their image's user and write to those workspaces, so this must be that user's UID/GID (for an image
# built from .devcontainer, HOST_UID/HOST_GID in .devcontainer/.env).
ACP_UID=501
ACP_GID=20
# The group owning /var/run/docker.sock as containers see it: the Docker proxy runs as nobody in this
# group to read the socket. Defaults to 0 (root, as on Docker Desktop); on Linux it is usually the
# docker group's GID.
DOCKER_SOCKET_GID=0
