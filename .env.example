# Copy to .env (gitignored) for `docker compose up`.

# Bearer token for the control plane API, used by `acp run` / `acp stop` (export it as ACP_API_TOKEN).
ACP_API_TOKEN=change-me
# The control plane config (see acp.example.yaml).
ACP_CONFIG=/home/you/projects/acp.yaml
# Mounted at the same path: must contain every target path and sessions.root in acp.yaml.
ACP_HOST_ROOT=/home/you/projects
# Mounted read-only at the same path: must contain every token and key path in acp.yaml.
# Keep it outside ACP_HOST_ROOT, which the devcontainer can read.
ACP_SECRETS_DIR=/home/you/acp-secrets
# Host user that owns the session workspaces (`id -u` / `id -g`), the same as HOST_UID/HOST_GID in
# .devcontainer/.env: agent containers run as that user.
ACP_UID=501
ACP_GID=20
