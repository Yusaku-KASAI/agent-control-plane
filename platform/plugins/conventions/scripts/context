#!/usr/bin/env bash
# Loads the rules, then tells where the documents they summarize are.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# A copy of the plugin elsewhere (such as a plugin cache) falls back to where every target declares
# the marketplace.
plugins=$(dirname "$root")
[[ -d $plugins/principles/docs ]] || plugins=/workspace/agent-platform/plugins
ctx="$(cat "$root"/rules/*.md)

文書の在りか：決まりは ${root}/docs/README.md、原則とパターンは ${plugins}/principles/docs/README.md。
文書を書くときは write-docs スキル、設計とレビューでは design スキルを使う。"
jq -n --arg event "$1" --arg ctx "$ctx" '{hookSpecificOutput: {hookEventName: $event, additionalContext: $ctx}}'
