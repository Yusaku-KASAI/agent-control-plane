#!/usr/bin/env bash
# Loads the rules, then tells where the documents they summarize are.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# principles sits beside this plugin in the same marketplace; a copy elsewhere (such as a plugin cache)
# can only name where to look.
principles=$(dirname "$root")/principles/docs/README.md
[[ -f $principles ]] || principles="同じマーケットプレイスの plugins/principles/docs/README.md"
# The rules link their sources relative to rules/; the injected text has no such base, so the links
# are turned into paths from the plugin's root.
ctx="$(sed "s#](\.\./#](${root}/#g" "$root"/rules/*.md)

文書の在りか：決まりは ${root}/docs/README.md、原則とパターンは ${principles}。
文書を書くときは write-docs スキル、設計とレビューでは design スキルを使う。"
jq -n --arg event "$1" --arg ctx "$ctx" '{hookSpecificOutput: {hookEventName: $event, additionalContext: $ctx}}'
