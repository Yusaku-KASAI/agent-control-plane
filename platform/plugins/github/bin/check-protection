#!/usr/bin/env bash
# Checks that the default branch of a repository is protected as target-template's guide
# (guides/github.md) sets it up: only pull requests, approvals that count only from humans,
# approvals dismissed on push, the required check `check` from GitHub Actions, and bypass only for
# pull requests. The expected values are an API-side copy of that guide; change both together.
#
# Usage: check-protection [<owner>/<repo> [<ref>]]
#   The repository defaults to $GITHUB_REPOSITORY, else the one gh sees here. The ref whose
#   CODEOWNERS is checked defaults to $GITHUB_SHA, else the default branch.
# Exits 0 when every check passes, 1 when one fails, 2 when GitHub cannot be read.
set -euo pipefail

# The app id of GitHub Actions, the only source the required check may come from.
actions_app=15368

repo=${1:-${GITHUB_REPOSITORY:-}}
if [[ -z $repo ]]; then
  repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner) || { echo "check-protection: cannot tell the repository" >&2; exit 2; }
fi

err=$(mktemp)
trap 'rm -f "$err"' EXIT

failed=0
ok() { echo "ok   $*"; }
ng() { echo "NG   $*"; failed=1; }
note() { echo "--   $*"; }
unreadable() { echo "check-protection: cannot read $1" >&2; exit 2; }

branch=$(gh api "repos/$repo" --jq .default_branch) || unreadable "repos/$repo"
ref=${2:-${GITHUB_SHA:-$branch}}
# Only active rules, from every ruleset (of the repository or its organization) that applies.
rules=$(gh api "repos/$repo/rules/branches/$branch") || unreadable "the rules of $branch"

has() { jq -e "$1" >/dev/null <<<"$rules"; }

if has 'any(.[]; .type == "deletion")'; then ok "$branch cannot be deleted"; else ng "$branch can be deleted (Restrict deletions)"; fi
if has 'any(.[]; .type == "non_fast_forward")'; then ok "$branch cannot be force-pushed"; else ng "$branch can be force-pushed (Block force pushes)"; fi

pr='[.[] | select(.type == "pull_request") | .parameters]'
if has "$pr | any(.required_approving_review_count >= 1)"; then
  ok "a pull request needs an approval"
else
  ng "a pull request is not required, or needs no approval (Require a pull request before merging, Required approvals 1)"
fi
if has "$pr | any(.required_approving_review_count >= 1 and .dismiss_stale_reviews_on_push)"; then
  ok "approvals are dismissed on push"
else
  ng "approvals stay after a push (Dismiss stale pull request approvals when new commits are pushed)"
fi

# Approvals count only from humans: code owners who are listed in a CODEOWNERS without errors, or
# a team that must approve every file. Neither can hold the agents' GitHub Apps.
humans=0
codeowners_review=0
has "$pr | any(.required_approving_review_count >= 1 and .require_code_owner_review)" && codeowners_review=1

if errors=$(gh api "repos/$repo/codeowners/errors?ref=$ref" 2>"$err"); then
  if [[ $(jq '.errors | length' <<<"$errors") -gt 0 ]]; then
    ng "CODEOWNERS at $ref has errors; such lines are ignored:"
    jq -r '.errors[] | "       \(.path):\(.line): \(.message // .kind)"' <<<"$errors"
  else
    ok "CODEOWNERS at $ref has no errors"
    # A rule without owners leaves its files without code owners, so no code owner approval is asked.
    content=""
    for path in .github/CODEOWNERS CODEOWNERS docs/CODEOWNERS; do
      if content=$(gh api -H "Accept: application/vnd.github.raw" "repos/$repo/contents/$path?ref=$ref" 2>/dev/null); then break; fi
      content=""
    done
    owners_ok=1
    if [[ -z $content ]]; then
      ng "CODEOWNERS at $ref cannot be read"
      owners_ok=0
    else
      first=$(grep -vE '^[[:space:]]*(#|$)' <<<"$content" | head -n 1 | awk '{print $1}')
      if [[ $first != "*" ]]; then
        ng "the first rule of CODEOWNERS is not '*', so some files may have no code owner"
        owners_ok=0
      fi
      ownerless=$(grep -vE '^[[:space:]]*(#|$)' <<<"$content" | sed 's/[[:space:]]#.*//' | awk 'NF < 2 {print "       " $0}')
      if [[ -n $ownerless ]]; then
        ng "CODEOWNERS has rules without owners; their files need no code owner approval:"
        echo "$ownerless"
        owners_ok=0
      fi
    fi
    if [[ $codeowners_review == 1 && $owners_ok == 1 ]]; then
      humans=1
      ok "approvals count only from the code owners"
    elif [[ $codeowners_review == 0 ]]; then
      note "CODEOWNERS is there, but code owner approval is not required (Require review from Code Owners)"
    fi
  fi
else
  if grep -q "HTTP 404" "$err"; then
    note "no CODEOWNERS at $ref"
  else
    cat "$err" >&2
    unreadable "the CODEOWNERS errors at $ref"
  fi
fi

if has "$pr | any(.required_approving_review_count >= 1 and any(.required_reviewers[]?; .reviewer.type == \"Team\" and .minimum_approvals >= 1 and any(.file_patterns[]; . == \"*\")))"; then
  humans=1
  ok "approvals count from a required team on every file"
fi
if [[ $humans == 0 ]]; then
  ng "approvals are not limited to humans: require code owner review with a CODEOWNERS of humans, or a required team on '*' with 1 approval"
fi

checks='[.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[] | select(.context == "check")]'
if has "$checks | length > 0 and all(.integration_id == $actions_app)"; then
  ok "the check 'check' from GitHub Actions is required"
else
  ng "the check 'check' is not required, or not only from GitHub Actions (Require status checks to pass)"
fi

# bypass_actors is returned only to callers who may write the ruleset, which GITHUB_TOKEN cannot.
# Of the repository roles, 5 is the admin role; a role that writes could hold the agents' Apps.
for id in $(jq -r '[.[].ruleset_id] | unique | .[]' <<<"$rules"); do
  ruleset=$(gh api "repos/$repo/rulesets/$id") || unreadable "the ruleset $id"
  if ! jq -e 'has("bypass_actors") and .bypass_actors != null' >/dev/null <<<"$ruleset"; then
    note "who may bypass the ruleset $id cannot be read with this token; check it on the settings page"
    continue
  fi
  bad=$(jq -r '.bypass_actors[] | select(.bypass_mode != "pull_request" or ((.actor_type != "RepositoryRole" or .actor_id != 5) and .actor_type != "OrganizationAdmin")) | "       \(.actor_type) \(.actor_id // "-") \(.bypass_mode)"' <<<"$ruleset")
  if [[ -n $bad ]]; then
    ng "the ruleset $id lets others bypass it, or not only for pull requests:"
    echo "$bad"
  else
    ok "the ruleset $id is bypassed only by admins, only for pull requests"
  fi
done

exit "$failed"
