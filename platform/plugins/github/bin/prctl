#!/usr/bin/env bash
# Keeps the pull request of the current branch describing what the branch contains, its diff
# reviewed, and its CI not failing. Needs git, gh and jq.
#
# The PR body carries a hidden marker with the head it describes, and each review is a GitHub review
# of the commit it covers, so whether both are current is read from GitHub and survives across
# sessions and containers.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage:
  prctl status                        the open PR of this branch, whether its body and review are
                                      current, and its CI on the head
  prctl since                         commits pushed since the body was last written
  prctl create [--base <branch>] <title> <body-file|->
                                      open a PR for the pushed branch, into the default branch or, to
                                      stack it on another PR, into that PR's branch; refused unless the
                                      body has the sections of writing.md (PR), in order, none empty
  prctl update [--title <title>] <body-file|-> [<comment-file>]
                                      replace the body (and title) and comment on what was pushed
                                      since the last update; the comment is required when there is
                                      such a push, and not posted when there is none; the body as for
                                      create
  prctl ci [--wait]                   the CI of the PR head; with --wait, until it has finished: "timeout"
                                      first after an hour, "none (...)" when no check run appears. One
                                      wait per branch, for the head of origin/<branch> here, also when it
                                      moves; another --wait while one runs ends at once ("already waiting")
  prctl unreviewed                    the range not yet reviewed, and its commits and files
  prctl review [--pr <number>] <commit> <review-json|->
                                      record the review of the range up to <commit> as a PR review,
                                      from its JSON (see the github skill): of scope "pr", the whole PR,
                                      at every perspective; of scope "since", the range since the last
                                      review, only in the thorough way; with --pr, of another's PR,
                                      always of scope "pr"
  prctl review --minor <commit> <note-file|->
                                      record the range up to <commit> as fixes of nitpicks that change
                                      no meaning, left unreviewed; refused when the PR has no review,
                                      none in the head's history, or right after another such record
  prctl ready                         take the PR out of draft, once it may end: a review of the whole
                                      PR, nothing but fixes of nitpicks after it, no finding that must
                                      be fixed, every finding answered (PRs are opened as drafts)
  prctl mode [normal|thorough]        the way the PR is reviewed, or set it: normal (the default), or
                                      thorough, by the label 念入りのレビュー
  prctl draft                         put the PR back into draft, to go on with it
  prctl answer <commit> <answers-json|->
                                      answer every finding of the review of <commit>, in a comment
  prctl worktree pr <number>          fetch another's PR and check its head out, detached, in a worktree
  prctl worktree default              the same for the head of the default branch (to review the whole)
  prctl worktree remove pr <number>|default
                                      remove that worktree
  prctl hook post-tool-use            Claude Code hook: remind after a push leaves the PR behind
  prctl hook stop                     Claude Code hook: keep the turn going while the PR is behind
USAGE
  exit 2
}

# The title of a record of fixes left unreviewed, by which it is told from a review.
readonly minor_title=レビューしない直し
# The label of a PR reviewed the thorough way (reviews.md: ways of reviewing); without it, the normal way.
readonly thorough_label=念入りのレビュー
# The hidden copies of a review's and of its answers' JSON, from which prctl reads them back.
readonly review_mark=prctl-review answers_mark=prctl-answers
# Absolute, as some commands change directory; a copy of prctl alone has none, and fails only where
# it needs them.
forms=$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" 2>/dev/null && pwd) || forms=/nonexistent
readonly forms
readonly marker_re='<!-- prctl: head=([0-9a-f]{40}) -->'

die() { echo "prctl: $*" >&2; exit 1; }

branch() { git symbolic-ref --quiet --short HEAD; }

remote_head() { git rev-parse --verify --quiet "refs/remotes/origin/$1"; }

# open_pr <branch>: the open PR whose head is <branch>, as JSON, or nothing. Looked up by head
# name: `gh pr view` without arguments resolves through the upstream, which can be another branch.
open_pr() {
  gh pr list --head "$1" --state open --limit 1 --json number,url,headRefOid,baseRefName,body,isDraft,labels \
    --jq '.[0] // empty'
}

# mode <pr>: the way the PR is reviewed: thorough when it has the label, else normal.
mode() {
  jq -r --arg l "$thorough_label" 'if any((.labels // [])[]; .name == $l) then "thorough" else "normal" end' <<<"$1"
}

described() {
  if [[ $(jq -r .body <<<"$1") =~ $marker_re ]]; then echo "${BASH_REMATCH[1]}"; fi
}

# review_list <pr>: the PR's reviews that count, one JSON line {id, commit, minor, copy} each: minor
# for a record of fixes left unreviewed (prctl review --minor), copy the base64 hidden copy of a
# review prctl recorded, or null. A submitted review with a body counts, whoever wrote it; a lone
# line comment or a reply is also a review on GitHub, but has no body. Fails when the reviews
# cannot be read.
review_list() {
  gh api --paginate "repos/{owner}/{repo}/pulls/$(jq -r .number <<<"$1")/reviews" \
    --jq ".[] | select(.state == \"COMMENTED\" or .state == \"APPROVED\" or .state == \"CHANGES_REQUESTED\")
      | select((.body // \"\") != \"\")
      | {id, commit: .commit_id, minor: (.body | startswith(\"## $minor_title\")),
         copy: (.body | rtrimstr(\"\\n\") | (split(\"\\n\") | last // \"\")
           | (capture(\"^<!-- $review_mark: (?<m>[A-Za-z0-9+/=]+) -->$\").m // null))} | tojson"
}

# records_of <list>: the list as lines "<commit> review" or "<commit> minor".
records_of() {
  [[ -z $1 ]] || jq -r '"\(.commit) \(if .minor then "minor" else "review" end)"' <<<"$1"
}

# review_records <pr>: the records of the PR's reviews (records_of). Fails when they cannot be read.
review_records() {
  local list
  list=$(review_list "$1") || return 1
  records_of "$list"
}

# last_reviewed <records> <head>: of the commits the records cover, the latest one in the history of
# <head>, or nothing.
last_reviewed() {
  local head=$2 id kind best="" n most=-1
  while read -r id kind; do
    if [[ -z $id ]] || ! git merge-base --is-ancestor "$id" "$head" 2>/dev/null; then continue; fi
    n=$(git rev-list --count "$id")
    if ((n > most)); then best=$id most=$n; fi
  done <<<"$1"
  echo "$best"
}

# reviewed <pr> <head>: the last reviewed commit of the PR in the history of <head>, or nothing.
reviewed() {
  local records
  records=$(review_records "$1") || return 1
  last_reviewed "$records" "$2"
}

# range_start <pr> <head> <last reviewed>: where the unreviewed range starts: the last reviewed
# commit, else where the branch left the base.
range_start() {
  if [[ -n $3 ]]; then echo "$3"; else git merge-base "origin/$(jq -r .baseRefName <<<"$1")" "$2"; fi
}

# How many reviews of the whole PR may not settle it before it goes back to the requester, either
# way of reviewing.
readonly final_cap=${PRCTL_FINAL_CAP:-10}

# review_facts <pr> <head> <list>: the facts of the PR's reviews (review_list) in the head's history,
# oldest first, as a JSON list of {commit, at, minor, scope, findings, answered}: at the commit's
# place in the history, scope and findings from the hidden copy (null and [] for a review without
# one), answered from the copy and from the comments that answer that very review (by its id).
# Fails when the comments cannot be read.
review_facts() {
  local answers order line n at
  answers=$(gh api --paginate "repos/{owner}/{repo}/issues/$(jq -r .number <<<"$1")/comments" \
    --jq ".[] | .body // \"\" | rtrimstr(\"\\n\") | (split(\"\\n\") | last // \"\")
      | capture(\"^<!-- $answers_mark: (?<m>[A-Za-z0-9+/=]+) -->$\").m" \
    | while read -r line; do base64 -d <<<"$line" 2>/dev/null; echo; done | jq -sc '[.[] | select(type == "object")]') || return 1
  # Order and filter by the head's history here: jq knows nothing of git. A commit's place is its
  # place in the history in topological order, so that a commit comes after all it is built on.
  order=$(git rev-list --topo-order --reverse "$2" | awk '{ print $0 " " NR }')
  { [[ -z $3 ]] || while read -r line; do
    n=$(jq -r .commit <<<"$line")
    at=$(awk -v c="$n" '$1 == c { print $2 }' <<<"$order")
    [[ -n $at ]] || continue
    jq -c --argjson at "$at" '. + {at: $at}' <<<"$line"
  done <<<"$3"; } | jq -sc --argjson answers "$answers" '
    sort_by(.at) | map(.id as $id
      | (.copy | if . then (@base64d | fromjson) else {} end) as $c
      | {commit, at, minor, scope: $c.scope, findings: ($c.findings // []),
         answered: ((($c.answered // []) + [$answers[] | select(.review_id == $id) | .answers[].finding]) | unique)})'
}

# handback_file <pr>: where this work tree keeps the commit of the last review of the whole PR
# counted when the PR last went back to the requester or was found to end; the cap counts those
# after it.
handback_file() { git rev-parse --git-path "prctl-handback-$(jq -r .number <<<"$1")"; }

# final_message <pr> <head> <list> [record]: what the PR still needs before it may end (a review of
# the whole PR that settles it), or nothing. With record, the place to count the cap afresh from is
# remembered: record=back when the PR goes back to the requester (the end of a turn only: prctl
# ready must not start the count afresh by being asked again), record=settled when it may end (the
# callers ask so only once nothing else holds the PR).
# Fails when the facts cannot be read.
final_message() {
  local facts order since mark at errors file
  file=$(handback_file "$1")
  facts=$(review_facts "$1" "$2" "$3") || return 1
  # Places in the history of the head, as review_facts gives them: the head's, and that of the commit
  # of the last review of the whole PR counted before (none when it is out of the history, as after
  # a rewrite, which counts them all: sooner rather than later).
  order=$(git rev-list --topo-order --reverse "$2" | awk '{ print $0 " " NR }')
  at=$(wc -l <<<"$order")
  mark=$(cat "$file" 2>/dev/null) || mark=""
  since=$(awk -v c="$mark" '$1 == c { print $2 }' <<<"$order")
  errors=$(jq -c -L "$forms" --argjson cap "$final_cap" --argjson since "${since:-0}" --argjson head "$at" \
    'include "review"; final_errors($cap; $since; $head)' <<<"$facts") || return 1
  if { [[ ${4:-} == settled && $errors == "[]" ]]; } \
    || { [[ ${4:-} == back ]] && jq -e 'any(.kind == "back")' <<<"$errors" >/dev/null; }; then
    jq -r '[.[] | select(.scope == "pr")] | last | .commit // empty' <<<"$facts" >"$file"
  fi
  [[ $errors != "[]" ]] || return 0
  jq -r --argjson e "$errors" '"PR #\(.number) may not end yet: \($e | map(.text) | join("; ")). A review of the whole PR is scope \"pr\", at every perspective, recorded with prctl review (see the github skill)."' <<<"$1"
}

# minor_refusal <list> <last reviewed>: why the range after <last reviewed> cannot be recorded as
# fixes left unreviewed, or nothing when it can. The fixes answer a review, so there has to be one,
# and the fixes of one review are pushed together, so the range follows a review, not another record.
minor_refusal() {
  local records
  records=$(records_of "$1")
  if [[ -z $records ]]; then
    echo "the PR has no review yet; have the range reviewed"
  elif [[ -z $2 ]]; then
    echo "none of the PR's reviews is in the history of the head (was it rewritten?); have the range reviewed"
  elif ! grep -qxF "$2 review" <<<"$records"; then
    echo "the last record at ${2:0:12} is itself of fixes left unreviewed; the fixes of a review are pushed together, so have the range reviewed"
  fi
}

# ci <head>: the head's CI. The first line is the state, which the first matching rule gives:
#   failed           a check run failed or timed out: something to fix
#   pending          a check run has not finished
#   action_required  a check run waits for a person
#   incomplete       a check run was cancelled or went stale: nothing was confirmed
#   passed           every check run succeeded, was neutral or was skipped
#   none             there is no check run (yet)
# The lines after it are "<name> <url>" of the check runs that gave the state. Only the latest run
# of each check counts: filter=latest keeps the latest within each check suite, but a head can have
# more than one suite (the PR reopened, the workflow run again), so of the runs of the same app and
# name, only the one with the greatest id is kept. Fails when the checks cannot be read.
ci() {
  local runs
  runs=$(gh api --paginate "repos/{owner}/{repo}/commits/$1/check-runs?filter=latest&per_page=100" \
    --jq '.check_runs[] | [.status, (.conclusion // ""), .name, (.details_url // .html_url // ""), (.app.id // "" | tostring), (.id | tostring)] | @tsv') || return 1
  [[ -n $runs ]] || { echo none; return; }
  jq -Rrn '[inputs | split("\t") | {status: .[0], conclusion: .[1], name: .[2], url: .[3], app: .[4], id: (.[5] | tonumber)}]
    | group_by([.app, .name]) | map(max_by(.id))
    | def pick(f): map(select(f) | [.name, .url] | map(select(. != "")) | join(" "));
      if any(.conclusion == "failure" or .conclusion == "timed_out") then
        ["failed"] + pick(.conclusion == "failure" or .conclusion == "timed_out")
      elif any(.status != "completed") then ["pending"] + pick(.status != "completed")
      elif any(.conclusion == "action_required") then ["action_required"] + pick(.conclusion == "action_required")
      elif all(.conclusion == "success" or .conclusion == "neutral" or .conclusion == "skipped") then ["passed"]
      else ["incomplete"] + pick(.conclusion != "success" and .conclusion != "neutral" and .conclusion != "skipped")
      end | .[]' <<<"$runs"
}

# settles <head> <ci>: whether nothing more can come of the head's CI: it passed, or the head has
# no workflow to run. Not knowing (the head is not in this clone) does not settle.
settles() {
  local workflows
  case ${2%%$'\n'*} in
    passed) return 0 ;;
    none)
      # --full-tree: the path is from the top of the repository, wherever this runs.
      workflows=$(git ls-tree --full-tree "$1" .github/workflows/ 2>/dev/null) || return 1
      [[ -z $workflows ]]
      ;;
    *) return 1 ;;
  esac
}

# wt_path <name>: where prctl keeps <name> in the container: the worktree for reading pr-<number> or
# default, or the lock ci-wait-<branch> of waiting for the CI. The same path every time, so that a
# later shell can find it. It is named after the main work tree, so that it is the same from inside
# any worktree.
wt_path() { echo "${TMPDIR:-/tmp}/prctl-$(basename "$(main_tree)")-$1"; }

# main_tree: the main work tree, wherever in its worktrees this runs.
main_tree() { dirname "$(git rev-parse --path-format=absolute --git-common-dir)"; }

# is_worktree <path>: whether <path> is a worktree of this repository.
# Git may keep the path with its links resolved (/tmp on macOS), so both spellings are tried.
is_worktree() {
  git worktree list --porcelain | grep -qxF -e "worktree $1" -e "worktree $(realpath "$1")"
}

# Reading another's PR, or the default branch, happens in a worktree of its own: the work tree's
# HEAD stays where it is, so neither the hooks meant for a PR's author nor the session's cleanup
# take it for this session's work.
cmd_worktree() {
  local kind=$1 number=${2:-} name commit pr base path from
  # From the main work tree: the worktree to be made again may be where this runs.
  cd "$(main_tree)"
  git worktree prune
  case $kind in
    pr)
      [[ $number =~ ^[0-9]+$ ]] || usage
      name=pr-$number
      pr=$(gh pr view "$number" --json number,headRefOid,baseRefName) || die "no PR #$number"
      base=$(jq -r .baseRefName <<<"$pr")
      git fetch -q origin "+refs/pull/$number/head:refs/prctl/$name" "+refs/heads/$base:refs/remotes/origin/$base"
      commit=$(git rev-parse "refs/prctl/$name")
      ;;
    default)
      [[ -z $number ]] || usage
      name=default
      base=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name) || die "could not read the default branch"
      git fetch -q origin "+refs/heads/$base:refs/remotes/origin/$base"
      commit=$(git rev-parse "refs/remotes/origin/$base")
      ;;
    *) usage ;;
  esac
  path=$(wt_path "$name")
  if [[ -e $path ]]; then
    is_worktree "$path" || die "$path is not a worktree of this repository; move it away"
    git worktree remove --force "$path"
  fi
  git worktree add -q --detach "$path" "$commit"
  echo "path: $path"
  echo "head: $commit"
  if [[ $kind == pr ]]; then
    from=$(git merge-base "origin/$base" "$commit")
    echo "range: $from..$commit (git -C $path diff $from $commit)"
    echo "after reviewing it: prctl review --pr $number $commit <review-json>"
  fi
  echo "when done: prctl worktree remove $kind${number:+ $number}"
}

cmd_worktree_remove() {
  local kind=$1 number=${2:-} name path
  case $kind in
    pr) [[ $number =~ ^[0-9]+$ ]] || usage; name=pr-$number ;;
    default) [[ -z $number ]] || usage; name=default ;;
    *) usage ;;
  esac
  path=$(wt_path "$name")
  # From the main work tree: the worktree may be where this runs.
  cd "$(main_tree)"
  if [[ -e $path ]]; then
    git worktree remove --force "$path" || die "could not remove $path"
  fi
  git worktree prune
  [[ $kind != pr ]] || git update-ref -d "refs/prctl/$name" 2>/dev/null || true
}

# How cmd_ci --wait polls, in seconds: how often, how long for a check run to appear after the push,
# and how long in all. The environment can change them (the tests do).
readonly ci_poll=${PRCTL_CI_POLL:-20} ci_appear=${PRCTL_CI_APPEAR:-300} ci_timeout=${PRCTL_CI_TIMEOUT:-3600}

# wait_lock <branch>: take the lock of waiting for the branch's CI, or say who holds it and fail.
# A kernel lock (flock), so that it goes with the process however that ends; the file holds the pid
# of the holder. It lives in the container's TMPDIR (else /tmp), beside the worktrees: on the mount
# of the work area (Docker Desktop), flock does not exclude. Without flock, or when it fails for
# another reason, every wait goes ahead.
wait_lock() {
  local file name=${1//%/%25} rc=0
  command -v flock >/dev/null || return 0
  file=$(wt_path "ci-wait-${name//\//%2F}")
  exec {wait_fd}>>"$file" || return 0
  flock -n -E 75 "$wait_fd" || rc=$?
  case $rc in
    0) echo $$ >"$file" ;;
    75)
      echo "already waiting for the CI of $1 (pid $(cat "$file" 2>/dev/null || echo unknown)), which follows"
      echo "origin/$1 here; its result comes when it ends, so this one does not wait"
      return 1
      ;;
  esac
}

cmd_ci() {
  local wait=$1 b pr head pushed now state="" first ended errors=0 start=$SECONDS
  b=$(branch) || die "not on a branch"
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b"
  head=$(jq -r .headRefOid <<<"$pr")
  if [[ -n $wait ]]; then
    wait_lock "$b" || return 0
    # The head of this clone's ref of the branch: usually its own last push, which the hooks look
    # at too, or a push fetched from elsewhere. GitHub moves the PR head only a moment after a push.
    pushed=$(remote_head "$b") || pushed=""
    head=${pushed:-$head}
  fi
  while :; do
    if state=$(ci "$head"); then
      errors=0
    else
      # While waiting, a passing network or API error is waited out too.
      errors=$((errors + 1))
      if [[ -z $wait ]] || ((errors >= 3)); then die "could not read the checks"; fi
    fi
    first=${state%%$'\n'*}
    [[ -n $wait ]] || break
    ended=""
    if settles "$head" "$state"; then
      ended=yes
    else
      case $first in
        pending) ((SECONDS - start < ci_timeout)) || { state="timeout"$'\n'"$state"; ended=yes; } ;;
        none) ((SECONDS - start < ci_appear)) || { state="none (no check run appeared within ${ci_appear}s)"; ended=yes; } ;;
        "") ;;
        *) ended=yes ;;
      esac
    fi
    # When this clone's ref of the branch moves (a push, ahead or back, or a fetch), the new head
    # supersedes whatever this one came to, also as this one ends: wait for it, from the start.
    now=$(remote_head "$b") || now=""
    if [[ -n $now && $now != "$pushed" ]]; then
      pushed=$now head=$now state="" errors=0 start=$SECONDS
      continue
    fi
    [[ -z $ended ]] || break
    sleep "$ci_poll"
  done
  echo "head: $head"
  echo "$state"
}

# pr_head <pr>: the PR's head, provided this clone has it.
pr_head() {
  local head
  head=$(jq -r .headRefOid <<<"$1")
  git cat-file -e "$head^{commit}" 2>/dev/null || die "this clone does not have the PR head ${head:0:12}; fetch first"
  echo "$head"
}

read_input() { if [[ $1 == - ]]; then cat; else cat -- "$1"; fi; }

with_marker() {
  local text=$1 head=$2
  text=$(sed -E 's/<!-- prctl: head=[0-9a-f]{40} -->//' <<<"$text")
  printf '%s\n\n<!-- prctl: head=%s -->\n' "$text" "$head"
}

# pushed_head <branch>: HEAD, provided it is what origin has.
pushed_head() {
  local head remote
  head=$(git rev-parse HEAD)
  remote=$(remote_head "$1") || die "$1 is not pushed"
  [[ $head == "$remote" ]] || die "HEAD differs from origin/$1; push first"
  echo "$head"
}

# stack_message <pr> <head>: what a PR stacked on another's branch needs, or nothing: the branch it
# is stacked on has moved on without it, or its PR was merged, or closed without merging. Says
# nothing when the default branch is not known here (origin/HEAD), the PR is into it, or a fact
# cannot be read (GitHub, or a head this clone does not have): nothing rather than something wrong.
stack_message() {
  local base def below last
  base=$(jq -r .baseRefName <<<"$1")
  def=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || return 0
  [[ $base != "${def#origin/}" ]] || return 0
  below=$(open_pr "$base" 2>/dev/null) || return 0
  if [[ -z $below ]]; then
    # The branch's latest PR: an earlier one may have been merged from the same branch.
    last=$(gh pr list --head "$base" --state all --limit 1 --json number,state --jq '.[0] // empty | "\(.number) \(.state)"' 2>/dev/null) || return 0
    [[ -n $last ]] || return 0
    if [[ ${last#* } == MERGED ]]; then
      jq -r --arg base "$base" --arg m "${last%% *}" '"PR #\(.number) is stacked on \($base), whose PR #\($m) was merged. Check that the PR is now into the default branch, and take the stacking out of the body (see the github skill)."' <<<"$1"
    else
      jq -r --arg base "$base" '"PR #\(.number) is stacked on \($base), whose PR was closed without being merged. Do not move the PR to the default branch, which would take in what was not merged: ask the requester what to do with it (see the github skill)."' <<<"$1"
    fi
  elif remote_head "$base" >/dev/null && git cat-file -e "$2^{commit}" 2>/dev/null \
    && ! git merge-base --is-ancestor "origin/$base" "$2"; then
    jq -r --arg base "$base" '"PR #\(.number) is stacked on \($base), which has commits it does not: merge origin/\($base) in and push (see the github skill)."' <<<"$1"
  fi
}

cmd_status() {
  local b pr head desc rev list end
  b=$(branch) || die "not on a branch"
  pr=$(open_pr "$b")
  [[ -n $pr ]] || { echo "no open PR for $b"; return; }
  head=$(jq -r .headRefOid <<<"$pr")
  desc=$(described "$pr")
  jq -r '"PR #\(.number) \(.url) (into \(.baseRefName))"' <<<"$pr"
  echo "reviewed:  the $(mode "$pr") way"
  echo "head:      $head"
  echo "described: ${desc:-nothing (no marker; prctl update writes one)}"
  if [[ $desc == "$head" ]]; then echo "body is current"; else echo "body is stale"; fi
  if git cat-file -e "$head^{commit}" 2>/dev/null; then
    if ! rev=$(reviewed "$pr" "$head"); then echo "could not read the reviews"
    elif [[ $rev == "$head" ]]; then echo "diff is reviewed"
    else echo "diff is not reviewed up to the head"; fi
  fi
  echo "ci:        $( (ci "$head" || echo "could not read the checks") | paste -sd ' ' -)"
  [[ $(git rev-parse HEAD) == "$head" ]] || echo "local HEAD $(git rev-parse --short HEAD) is not the PR head"
  stack_message "$pr" "$head"
  if git cat-file -e "$head^{commit}" 2>/dev/null; then
    if [[ $(jq -r '.isDraft // false' <<<"$pr") == true ]]; then echo "end:       a draft; prctl ready checks it"
    elif ! list=$(review_list "$pr") || ! end=$(final_message "$pr" "$head" "$list"); then echo "end:       could not read the reviews"
    else echo "end:       ${end:-may end}"; fi
  fi
}

cmd_since() {
  local b pr head desc
  b=$(branch) || die "not on a branch"
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b"
  head=$(jq -r .headRefOid <<<"$pr")
  desc=$(described "$pr")
  [[ -n $desc ]] || die "the body has no marker; describe the whole branch"
  [[ $desc != "$head" ]] || { echo "nothing since the last update"; return; }
  if git merge-base --is-ancestor "$desc" "$head" 2>/dev/null; then
    git log --format='%h %s' "$desc..$head"
    git diff --stat "$desc" "$head"
  else
    echo "history was rewritten since ${desc:0:12}; explain the rewrite in the comment"
    git log --format='%h %s' "origin/$(jq -r .baseRefName <<<"$pr")..$head"
  fi
}

cmd_unreviewed() {
  local b pr head list rev from base
  b=$(branch) || die "not on a branch"
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b"
  head=$(pr_head "$pr")
  base=$(jq -r .baseRefName <<<"$pr")
  list=$(review_list "$pr") || die "could not read the reviews of the PR"
  rev=$(last_reviewed "$(records_of "$list")" "$head")
  from=$(range_start "$pr" "$head" "$rev")
  [[ $from != "$head" ]] || { echo "reviewed up to the head"; return; }
  if [[ $(mode "$pr") == thorough ]]; then
    echo "range: $from..$head"
    echo "after reviewing it: prctl review $head <review-json>"
  else
    # The normal way reviews the whole PR every time: the range, its commits and files are the whole PR's.
    echo "not reviewed since: ${rev:-the start of the PR}"
    from=$(range_start "$pr" "$head" "")
    echo "range: $from..$head (the whole PR: reviewed the normal way, whole every time)"
    echo "after reviewing the whole PR, at every perspective (scope \"pr\"): prctl review $head <review-json>"
  fi
  if [[ -z $(minor_refusal "$list" "$rev") ]]; then
    echo "or, if it only fixes nitpicks of the last review: prctl review --minor $head <note>"
  fi
  # Commits merged in from the base are not this branch's change.
  git log --format='%h %s' "$from..$head" "^origin/$base"
  if [[ -n $(git rev-list --merges "$from..$head" "^origin/$base") ]]; then
    echo "the range merges the base; review the commits above rather than git diff $from $head"
  else
    git diff --stat "$from" "$head"
  fi
}

# cmd_review <number> <minor> <commit> <review-json or note>: with <number>, of another's PR; with <minor>, the
# range is recorded as left unreviewed, which counts as reviewed all the same.
cmd_review() {
  local number=$1 minor=$2 commit input review="" scope="" body b pr head list rev why from base title
  commit=$(git rev-parse --verify --quiet "$3^{commit}") || die "no commit $3; fetch the PR head first"
  input=$(read_input "$4")
  if [[ -n $minor ]]; then
    [[ -n ${input//[[:space:]]/} ]] || die "the note is empty; say which review's nitpicks the range fixes"
  else
    review=$(jq -c . <<<"$input" 2>/dev/null) || review=""
    [[ -n $review ]] || die "the review is not JSON (see the github skill)"
    form_check "$review" review_errors
    scope=$(jq -r .scope <<<"$review")
    [[ -z $number || $scope == pr ]] || die "a review of another's PR is of scope \"pr\": the whole PR, at every perspective"
    if jq -e .answers <<<"$review" >/dev/null; then
      # shellcheck disable=SC2016 # a jq expression
      form_check "$review" '. as $r | .answers | answer_errors($r)'
    fi
  fi
  if [[ -n $number ]]; then
    # Another's PR: read by number, and reviewed whole, from where it left its base.
    pr=$(gh pr view "$number" --json number,url,headRefOid,baseRefName,body) || die "no PR #$number"
    head=$(pr_head "$pr")
    git merge-base --is-ancestor "$commit" "$head" || die "${commit:0:12} is not in the PR (head ${head:0:12})"
    base=$(jq -r .baseRefName <<<"$pr")
    from=$(git merge-base "origin/$base" "$commit") || die "no origin/$base here; fetch it first"
  else
    b=$(branch) || die "not on a branch"
    pr=$(open_pr "$b")
    [[ -n $pr ]] || die "no open PR for $b; review before prctl create, then record it after"
    [[ $scope != since || $(mode "$pr") == thorough ]] \
      || die "PR #$(jq -r .number <<<"$pr") is reviewed the normal way, whole every time: review the whole PR, at every perspective (scope \"pr\"), or set the thorough way first (prctl mode thorough)"
    head=$(pr_head "$pr")
    git merge-base --is-ancestor "$commit" "$head" || die "${commit:0:12} is not in the PR (head ${head:0:12})"
    list=$(review_list "$pr") || die "could not read the reviews of the PR"
    rev=$(last_reviewed "$(records_of "$list")" "$head")
    # The first review of a PR covers it whole, at every perspective.
    [[ -n $rev || -n $minor || $scope == pr ]] || die "the PR has no review in the head's history yet; review the whole PR, at every perspective (scope \"pr\")"
    if [[ $scope == pr ]]; then
      # The whole PR, whatever was reviewed before.
      from=$(range_start "$pr" "$commit" "")
    else
      from=$(range_start "$pr" "$head" "$rev")
      if [[ $commit == "$from" ]] || ! git merge-base --is-ancestor "$from" "$commit"; then
        die "${commit:0:12} is not after the last reviewed ${from:0:12}"
      fi
    fi
    if [[ -n $minor ]]; then
      why=$(minor_refusal "$list" "$rev")
      [[ -z $why ]] || die "$why"
    fi
  fi
  if [[ -n $minor ]]; then
    body=$(printf '## %s（%s...%s）\n\n%s\n' "$minor_title" "${from:0:12}" "${commit:0:12}" "$input")
  else
    if [[ $scope == pr ]]; then title="PR 全体"; else title="前回から"; fi
    body=$(jq -r -L "$forms" --arg t "差分のレビュー（${from:0:12}...${commit:0:12}、$title）" \
      'include "review"; render_review($t; .answers)' <<<"$review")
    body+=$'\n\n'"<!-- $review_mark: $(jq -c -L "$forms" --arg c "$commit" 'include "review"; record + {commit: $c}' <<<"$review" | base64 | tr -d '\n') -->"
  fi
  # GitHub takes a body of up to 65536 characters.
  ((${#body} <= 65536)) || die "the review is ${#body} characters, over GitHub's 65536; shorten the findings or record them in parts"
  gh api -X POST "repos/{owner}/{repo}/pulls/$(jq -r .number <<<"$pr")/reviews" --jq .html_url -f event=COMMENT \
    -f commit_id="$commit" -f body="$body"
}

# form_check <json> <jq expression giving the errors> [<jq options>...]: die with the errors of the
# form, if any.
form_check() {
  local json=$1 expr=$2 errors
  shift 2
  errors=$(jq -r -L "$forms" "$@" "include \"review\"; [$expr] | flatten | .[]" <<<"$json" 2>&1) || die "could not check the form: $errors"
  [[ -z $errors ]] || die "the form is not right (see the github skill):"$'\n'"$errors"
}

# review_at <pr> <commit>: {id, review} of the latest review of <commit> that prctl recorded (its
# hidden copy), or nothing. Fails when the reviews cannot be read.
review_at() {
  local list
  list=$(review_list "$1") || return 1
  [[ -z $list ]] || jq -sc --arg c "$2" '[.[] | select(.commit == $c and .copy != null)] | last // empty
    | {id, review: (.copy | @base64d | fromjson)}' <<<"$list"
}

cmd_answer() {
  local commit answers b pr at review
  commit=$(git rev-parse --verify --quiet "$1^{commit}") || die "no commit $1"
  answers=$(jq -c . <<<"$(read_input "$2")" 2>/dev/null) || answers=""
  [[ -n $answers ]] || die "the answers are not JSON (see the github skill)"
  b=$(branch) || die "not on a branch"
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b"
  at=$(review_at "$pr" "$commit") || die "could not read the reviews of the PR"
  [[ -n $at ]] || die "no review of ${commit:0:12} recorded by prctl"
  review=$(jq -c .review <<<"$at")
  # shellcheck disable=SC2016 # a jq expression
  form_check "$answers" 'answer_errors($review)' --argjson review "$review"
  gh api "repos/{owner}/{repo}/issues/$(jq -r .number <<<"$pr")/comments" --jq .html_url -f body="$(
    jq -r -L "$forms" --arg t "${commit:0:12} までのレビューへの答え" 'include "review"; render_answers($t)' <<<"$answers"
    printf '\n\n<!-- %s: %s -->\n' "$answers_mark" "$(jq -c --arg c "$commit" --argjson id "$(jq .id <<<"$at")" '{review: $c, review_id: $id, answers: .}' <<<"$answers" | base64 | tr -d '\n')"
  )"
}

# The sections every PR body has, in this order, each with something written under it (writing.md:
# PR). What is written under them is free.
readonly body_sections=(何を変えるか 当てはめた決まり どう確かめたか 確かめていないこと)

# body_check <body>: die unless the body has the sections, in order, once each, none of them empty.
# Lines in code blocks are not headings. Lines that only close or refer to an issue, and the
# attribution line, do not count as what is written under a section.
body_check() {
  local errors
  errors=$(jq -Rrs --args '
    [foreach (split("\n")[]) as $l ({fence: false};
        if $l | test("^\\s*(```|~~~)") then .fence = (.fence | not) | .line = $l | .head = null
        else .line = $l | .head = (if .fence | not then ($l | capture("^## (?<n>.*?)\\s*$").n // null) else null end) end;
        {line, head})] as $lines
    | [$lines | to_entries[] | select(.value.head != null) | {at: .key, name: .value.head}] as $heads
    | ($ARGS.positional) as $want
    | [ ($want[] as $w
          | ($heads | map(select(.name == $w))) as $hs
          | if ($hs | length) == 0 then "no section ## \($w)"
            elif ($hs | length) > 1 then "the section ## \($w) appears \($hs | length) times"
            else ($heads | map(select(.at > $hs[0].at)) | first | .at // ($lines | length)) as $end
              | if [$lines[$hs[0].at + 1:$end][] | .line
                    | select(test("\\S") and (test("^\\s*((Closes|Fixes|Resolves|Refs) #[0-9]+|🤖 )") | not))] | length == 0
                then "the section ## \($w) is empty" else empty end
            end),
        ([$heads[] | .name | select(IN($want[]))] as $got
         | if ($got | length) == ($want | length) and ($got | unique | length) == ($want | length) and $got != $want
         then "the sections are not in the order: \($want | join(", "))" else empty end) ]
    | .[]' "${body_sections[@]}" <<<"$1")
  [[ -z $errors ]] || die "the body is not in the form (writing.md: PR; see the github skill):"$'\n'"$errors"
}

cmd_create() {
  local base=$1 title=$2 body b head
  body=$(read_input "$3")
  body_check "$body"
  b=$(branch) || die "not on a branch"
  head=$(pushed_head "$b")
  [[ -z $(open_pr "$b") ]] || die "$b already has an open PR; use prctl update"
  if [[ -n $base ]]; then
    # Stacked: the base is another PR's branch, which the branch is built on.
    [[ $base != "$b" ]] || die "a PR cannot be stacked on its own branch"
    remote_head "$base" >/dev/null || die "origin/$base is not here; fetch it, or push it first"
    git merge-base --is-ancestor "origin/$base" "$head" || die "$b is not built on origin/$base; merge it in first"
    [[ -n $(open_pr "$base") ]] || die "$base has no open PR to stack on"
  else
    base=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
  fi
  # A draft until prctl ready: on its way, it is not held for a review of the whole PR.
  gh pr create --draft --base "$base" --head "$b" --title "$title" --body "$(with_marker "$body" "$head")"
}

# cmd_ready: take the PR out of draft, once it may end (reviews.md: before ending).
cmd_ready() {
  local b head pr list msg
  b=$(branch) || die "not on a branch"
  head=$(pushed_head "$b")
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b"
  [[ $(jq -r .headRefOid <<<"$pr") == "$head" ]] || die "GitHub has not caught up with the push yet; retry"
  [[ $(jq -r '.isDraft // false' <<<"$pr") == true ]] || { echo "PR #$(jq -r .number <<<"$pr") is not a draft"; return; }
  list=$(review_list "$pr") || die "could not read the reviews of the PR"
  msg=$(pending_message "$pr" "$head" "" "$list") || die "could not read the reviews of the PR"
  [[ -z $msg ]] || die "not ready: ${msg% }"
  # Going back to the requester is for the end of the turn to remember; here only a PR that may end.
  msg=$(final_message "$pr" "$head" "$list" settled) || die "could not read the reviews of the PR"
  [[ -z $msg ]] || die "$msg"
  draft_state "$pr" markPullRequestReadyForReview
}

# cmd_mode [normal|thorough]: tell the way the PR is reviewed, or set it by the label.
cmd_mode() {
  local b pr number
  b=$(branch) || die "not on a branch"
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b"
  number=$(jq -r .number <<<"$pr")
  case ${1:-} in
    "") echo "PR #$number is reviewed the $(mode "$pr") way" ;;
    thorough)
      # The label has to be there before a PR can carry it; one already there is no failure.
      gh api "repos/{owner}/{repo}/labels" -f name="$thorough_label" -f color=5319e7 >/dev/null 2>&1 || true
      gh api -X POST "repos/{owner}/{repo}/issues/$number/labels" -f "labels[]=$thorough_label" >/dev/null \
        || die "could not label PR #$number"
      echo "PR #$number is reviewed the thorough way"
      ;;
    normal)
      [[ $(mode "$pr") == normal ]] || gh api -X DELETE "repos/{owner}/{repo}/issues/$number/labels/$(jq -rn --arg l "$thorough_label" '$l | @uri')" >/dev/null \
        || die "could not unlabel PR #$number"
      echo "PR #$number is reviewed the normal way"
      ;;
    *) usage ;;
  esac
}

# cmd_draft: put the PR back into draft, to go on with it (another request after it was ready).
cmd_draft() {
  local b pr
  b=$(branch) || die "not on a branch"
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b"
  [[ $(jq -r '.isDraft // false' <<<"$pr") != true ]] || { echo "PR #$(jq -r .number <<<"$pr") is a draft already"; return; }
  draft_state "$pr" convertPullRequestToDraft
}

# draft_state <pr> <mutation>: take the PR out of draft, or back into it. By GraphQL, as REST has no
# way to, and directly rather than by gh pr ready, whose query reads other repository features that
# can fail (as gh pr edit does, see cmd_update).
draft_state() {
  local node
  node=$(gh api "repos/{owner}/{repo}/pulls/$(jq -r .number <<<"$1")" --jq .node_id) || die "could not read the PR"
  gh api graphql -f query="mutation(\$id: ID!) { $2(input: {pullRequestId: \$id}) { pullRequest { url } } }" \
    -f id="$node" --jq ".data.$2.pullRequest.url"
}

cmd_update() {
  local title=$1 body comment="" b pr num head desc
  body=$(read_input "$2")
  body_check "$body"
  [[ -z ${3:-} ]] || comment=$(read_input "$3")
  b=$(branch) || die "not on a branch"
  head=$(pushed_head "$b")
  pr=$(open_pr "$b")
  [[ -n $pr ]] || die "no open PR for $b; use prctl create"
  num=$(jq -r .number <<<"$pr")
  [[ $(jq -r .headRefOid <<<"$pr") == "$head" ]] || die "GitHub has not caught up with the push yet; retry"
  desc=$(described "$pr")
  if [[ -n $desc && $desc != "$head" ]]; then
    [[ -n $comment ]] || die "say in a comment what changed since ${desc:0:12} and why"
    gh api "repos/{owner}/{repo}/issues/$num/comments" \
      -f body="$(printf '%s\n\n%s...%s\n' "$comment" "${desc:0:12}" "${head:0:12}")" --jq .html_url
  elif [[ -n $comment ]]; then
    echo "prctl: nothing was pushed since the body was last written; the comment is not posted" >&2
  fi
  # REST rather than `gh pr edit`, whose GraphQL query can fail on unrelated repository features.
  local fields=(-f body="$(with_marker "$body" "$head")")
  [[ -z $title ]] || fields+=(-f title="$title")
  gh api -X PATCH "repos/{owner}/{repo}/pulls/$num" "${fields[@]}" --jq .html_url
}

body_message() {
  local pr=$1 head=$2 desc
  desc=$(described "$pr")
  jq -r --arg head "${head:0:12}" --arg desc "${desc:0:12}" 'if $desc == "" then "The body of PR #\(.number) was not written by prctl. Rewrite it with prctl update <body>; no comment is needed (see the github skill)." else "PR #\(.number) now has head \($head) but its body describes \($desc). Rewrite the body to describe the branch as it is now (and the title if the scope changed), and comment on what this push changed and why: prctl since, then prctl update [--title <title>] <body> <comment> (see the github skill)." end' <<<"$pr"
}

# review_message <pr> <head> <minor>: with <minor>, the range can be recorded as fixes left unreviewed.
# What to review is of the way the PR is reviewed.
review_message() {
  local minor=${3:+ If the range only fixes nitpicks of the last review without changing any meaning, record it with prctl review --minor <commit> <note> instead.}
  if [[ $(mode "$1") == thorough ]]; then
    jq -r --arg head "${2:0:12}" --arg minor "$minor" '"The diff of PR #\(.number) is not reviewed up to \($head). Run prctl unreviewed, have subagents review that range, one for each perspective (if they already reviewed exactly that range, only record it), and record it with prctl review <commit> <review-json>.\($minor) (See the github skill.)"' <<<"$1"
  else
    jq -r --arg head "${2:0:12}" --arg minor "$minor" '"The diff of PR #\(.number) is not reviewed up to \($head). It is reviewed the normal way: have a subagent review the whole PR, at every perspective (if one already reviewed the whole PR up to there, only record it), and record it with prctl review <commit> <review-json> (scope \"pr\").\($minor) (See the github skill.)"' <<<"$1"
  fi
}

ci_message() {
  jq -r --arg head "${2:0:12}" --arg failed "$3" '"CI failed on \($head) of PR #\(.number): \($failed). Read the failed logs (gh run view <run ID> --log-failed; the run ID is in the URL), find the cause, and fix it (see the github skill)."' <<<"$1"
}

# pending_message <pr> <head> [<ci> [<review list>]]: what the PR still needs for this head, or nothing. Of the CI,
# only a failure needs something: nobody waits for a running one. Fails when the reviews cannot be
# read, so that a hook says nothing rather than something wrong.
pending_message() {
  local pr=$1 head=$2 state=${3:-} list rev minor="" msg failed msgs=()
  [[ $(described "$pr") == "$head" ]] || msgs+=("$(body_message "$pr" "$head")")
  if [[ $# -ge 4 ]]; then list=$4; else list=$(review_list "$pr") || return 1; fi
  rev=$(last_reviewed "$(records_of "$list")" "$head")
  if [[ $rev != "$head" ]]; then
    [[ -n $(minor_refusal "$list" "$rev") ]] || minor=yes
    msgs+=("$(review_message "$pr" "$head" "$minor")")
  fi
  msg=$(stack_message "$pr" "$head")
  [[ -z $msg ]] || msgs+=("$msg")
  if [[ ${state%%$'\n'*} == failed ]]; then
    failed=$(tail -n +2 <<<"$state" | jq -Rrs 'split("\n") | map(select(. != "")) | join("; ")')
    msgs+=("$(ci_message "$pr" "$head" "$failed")")
  fi
  [[ ${#msgs[@]} -eq 0 ]] || printf '%s ' "${msgs[@]}"
}

# Hooks never fail the tool call or the turn on their own errors: a missing PR, gh or network is
# a normal state for them.
hook_post_tool_use() {
  local b remote state pr msg
  b=$(branch) || return 0
  remote=$(remote_head "$b") || return 0
  [[ $remote == "$(git rev-parse HEAD)" ]] || return 0
  # One reminder per pushed head; the Stop hook catches what this misses. The pushed head is
# compared rather than the PR's, which GitHub updates a moment after the push.
  state=$(git rev-parse --git-path prctl-notified)
  [[ $(cat "$state" 2>/dev/null) != "$remote" ]] || return 0
  echo "$remote" >"$state"
  pr=$(open_pr "$b" 2>/dev/null) || return 0
  [[ -n $pr ]] || return 0
  msg=$(pending_message "$pr" "$remote") || return 0
  [[ -n $msg ]] || return 0
  jq -n --arg ctx "$msg" \
    '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $ctx}}'
}

# Only a head pushed from this working tree counts, and a head once seen described, reviewed, out of
# draft, allowed to end and passing CI is not asked about again with the same reviews: most turns
# read only the PR and its reviews.
hook_stop() {
  local input=$1 b remote state pr checks list draft msg final settled
  [[ $(jq -r '.stop_hook_active // false' <<<"$input") != true ]] || return 0
  b=$(branch) || return 0
  remote=$(remote_head "$b") || return 0
  [[ $remote == "$(git rev-parse HEAD)" ]] || return 0
  state=$(git rev-parse --git-path prctl-settled)
  pr=$(open_pr "$b" 2>/dev/null) || return 0
  [[ -n $pr ]] || return 0
  list=$(review_list "$pr" 2>/dev/null) || return 0
  # A head is settled with the reviews it had: another review of the same head may change whether the
  # PR may end.
  settled="$remote $(grep -c . <<<"$list")"
  [[ $(cat "$state" 2>/dev/null) != "$settled" ]] || return 0
  # Checks that cannot be read are left out, and keep the head unsettled.
  checks=$(ci "$remote" 2>/dev/null) || checks=""
  msg=$(pending_message "$pr" "$remote" "$checks" "$list") || return 0
  draft=$(jq -r '.isDraft // false' <<<"$pr")
  # Out of draft, whether it may end at all is asked along with the rest: the hook stops a turn once,
  # so that what the rest asks for, once done, would let the turn end without it. A draft is still
  # on its way and not held; prctl ready asks the same before it leaves draft. Either way, the end of
  # a turn remembers where to count the cap from once the PR goes back to the requester.
  final=$(final_message "$pr" "$remote" "$list" back) || final=""
  [[ $draft == true ]] || msg+=${final:+$final }
  if [[ -z $msg ]]; then
    # Nothing holds the turn: an out-of-draft PR may end, so the count goes afresh from here. A head is
    # settled only once nothing more can come of its CI, and not while a draft, which leaves draft
    # without a push; until then, later turns look again.
    if [[ $draft != true ]]; then
      final_message "$pr" "$remote" "$list" settled >/dev/null || true
      ! settles "$remote" "$checks" || echo "$settled" >"$state"
    fi
    return 0
  fi
  # The turn's last message is the answer the requester reads, so it has to be the whole report again.
  jq -n --arg reason "${msg% } Then end with your full answer to the request again, not only this update." \
    '{decision: "block", reason: $reason}'
}

cmd_hook() {
  local input dir
  input=$(cat)
  dir=$(jq -r '.cwd // empty' <<<"$input")
  cd "${dir:-.}" 2>/dev/null || return 0
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  case $1 in
    post-tool-use) hook_post_tool_use || true ;;
    stop) hook_stop "$input" || true ;;
    *) usage ;;
  esac
}

# The whole script is read before anything runs: bash reads a script as it goes, and a wait can
# outlast an edit of this file in place.
main() {
  case "${1:-}" in
    status) [[ $# -eq 1 ]] || usage; cmd_status ;;
    since) [[ $# -eq 1 ]] || usage; cmd_since ;;
    unreviewed) [[ $# -eq 1 ]] || usage; cmd_unreviewed ;;
    ci)
      [[ $# -eq 1 || ( $# -eq 2 && $2 == --wait ) ]] || usage
      cmd_ci "${2:-}"
      ;;
    review)
      case ${2:-} in
        --pr) [[ $# -eq 5 ]] || usage; cmd_review "$3" "" "$4" "$5" ;;
        --minor) [[ $# -eq 4 ]] || usage; cmd_review "" yes "$3" "$4" ;;
        *) [[ $# -eq 3 ]] || usage; cmd_review "" "" "$2" "$3" ;;
      esac
      ;;
    answer) [[ $# -eq 3 ]] || usage; cmd_answer "$2" "$3" ;;
    ready) [[ $# -eq 1 ]] || usage; cmd_ready ;;
    draft) [[ $# -eq 1 ]] || usage; cmd_draft ;;
    mode) [[ $# -le 2 ]] || usage; cmd_mode "${2:-}" ;;
    create)
      if [[ ${2:-} == --base ]]; then
        [[ $# -eq 5 ]] || usage
        cmd_create "$3" "$4" "$5"
      else
        [[ $# -eq 3 ]] || usage
        cmd_create "" "$2" "$3"
      fi
      ;;
    update)
      shift
      title=""
      if [[ ${1:-} == --title ]]; then
        [[ $# -ge 2 ]] || usage
        title=$2
        shift 2
      fi
      [[ $# -eq 1 || $# -eq 2 ]] || usage
      cmd_update "$title" "$1" "${2:-}"
      ;;
    worktree)
      case ${2:-} in
        remove) [[ $# -ge 3 && $# -le 4 ]] || usage; cmd_worktree_remove "$3" "${4:-}" ;;
        *) [[ $# -ge 2 && $# -le 3 ]] || usage; cmd_worktree "$2" "${3:-}" ;;
      esac
      ;;
    hook) [[ $# -eq 2 ]] || usage; cmd_hook "$2" ;;
    *) usage ;;
  esac
}

main "$@"; exit
