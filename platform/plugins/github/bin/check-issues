#!/usr/bin/env bash
# Checks the open issues of a repository against conventions' docs/reference/issues.md ("整っている
# 状態"): every issue but the theme issues and the roadmap carries a label of where it changes and a
# theme:<name> label, every theme issue has the sections of a theme ("テーマ"), in order, once each,
# the roadmap's "## 今の焦点" names only open issues of this repository (a closed issue, a pull
# request, or a number that is neither here is a drift), and no issue is blocked by a closed one. Only what needs no judgement is checked; the rest of the tidy state is left to the
# procedure that tidies issues.
#
# Usage: check-issues [<owner>/<repo>]
#   The repository defaults to $GITHUB_REPOSITORY, else the one gh sees here.
# Exits 0 when every check passes, 1 when one fails, 2 when GitHub cannot be read. Each failure is
# an NG line.
set -euo pipefail

repo=${1:-${GITHUB_REPOSITORY:-}}
if [[ -z $repo ]]; then
  repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner) || { echo "check-issues: cannot tell the repository" >&2; exit 2; }
fi
owner=${repo%/*} name=${repo#*/}

failed=0
ok() { echo "ok   $*"; }
ng() { echo "NG   $*"; failed=1; }
unreadable() { echo "check-issues: cannot read $1" >&2; exit 2; }

issues=$(gh issue list -R "$repo" --state open --limit 1000 --json number,title,labels,body) || unreadable "the open issues"
# The $ are GraphQL variables, not the shell's.
# shellcheck disable=SC2016
roadmap=$(gh api graphql -f owner="$owner" -f name="$name" -f query='
  query($owner: String!, $name: String!) {
    repository(owner: $owner, name: $name) { pinnedIssues(first: 10) { nodes { issue { number title body } } } }
  }' --jq '[.data.repository.pinnedIssues.nodes[].issue | select(.title == "ロードマップ")][0] // empty') ||
  unreadable "the pinned issues"
roadmap_number=$(jq -r '.number // empty' <<<"${roadmap:-null}")

# Labels: a theme issue (label theme) and the roadmap are not members of a theme.
# GitHub's default labels are not labels of where (conventions' issues.md, "どこを変えるか").
defaults=$(gh label list -R "$repo" --limit 1000 --json name,isDefault --jq '[.[] | select(.isDefault) | .name]') ||
  unreadable "the labels"
missing=$(jq -r --arg roadmap "${roadmap_number:-0}" --argjson defaults "$defaults" '.[]
  | select((.number | tostring) != $roadmap)
  | .number as $number
  | [.labels[].name] as $labels
  | select(($labels | index("theme")) | not)
  | (if any($labels[]; startswith("theme:")) then [] else ["theme:<名前>"] end)
    + (if any($labels[]; . != "theme" and (startswith("theme:") | not) and . != "canvas"
      and (. as $l | $defaults | index($l) | not)) then [] else ["どこを変えるか"] end)
  | select(length > 0) as $lack
  | "#\($number) \($lack | join(" と ")) のラベルがない"' <<<"$issues")
if [[ -n $missing ]]; then
  while IFS= read -r line; do ng "$line"; done <<<"$missing"
else
  ok "every open issue has the labels of where and what for"
fi

# The sections of a theme issue (conventions' issues.md, "テーマ"). Headings in code blocks are not
# sections; a heading may end in spaces or CR.
theme_sections=(狙い 目指す姿 進め方)
lacking=$(jq -r --args '.[]
  | select(any(.labels[]; .name == "theme"))
  | .number as $number
  | [foreach ((.body // "") | split("\n")[]) as $l ({fence: false, head: null};
      if $l | test("^\\s*(```|~~~)") then .fence = (.fence | not) | .head = null
      else .head = (if .fence then null else ($l | capture("^## (?<n>.*?)\\s*$").n // null) end) end;
      .head | select(. != null))] as $heads
  | [$heads[] | select(IN($ARGS.positional[]))] as $got
  | select($got != $ARGS.positional)
  | "#\($number) テーマの本文に \($ARGS.positional | map("## \(.)") | join("、")) の節がこの順に一度ずつない（ある節：\(if $got == [] then "なし" else $got | join("、") end)）"' \
  "${theme_sections[@]}" <<<"$issues")
if [[ -n $lacking ]]; then
  while IFS= read -r line; do ng "$line"; done <<<"$lacking"
else
  ok "every theme issue has the sections of a theme"
fi

# The roadmap's focus.
if [[ -z $roadmap_number ]]; then
  echo "--   no pinned issue titled ロードマップ; the focus is not checked"
else
  body=$(jq -r '.body' <<<"$roadmap" | tr -d '\r')
  if ! grep -q '^## 今の焦点' <<<"$body"; then
    ng "the roadmap #$roadmap_number has no section ## 今の焦点"
  else
    focus=$(awk '/^## /{inside = ($0 ~ /^## 今の焦点/); next} inside' <<<"$body")
    closed=() prs=() unknown=()
    err=$(mktemp)
    # Only #N counts as this repository's: other-repo#3 and URLs point elsewhere or are not read.
    while read -r n; do
      [[ -n $n ]] || continue
      # The issues API answers for pull requests too; the focus lists issues only (conventions' ADR 0029).
      if state=$(gh api "repos/$repo/issues/$n" --jq 'if .pull_request then "pull request" else .state end' 2>"$err"); then
        case $state in
          closed) closed+=("#$n") ;;
          "pull request") prs+=("#$n") ;;
        esac
      elif grep -qE 'HTTP (404|410)' "$err"; then
        unknown+=("#$n")
      else
        rm -f "$err"; unreadable "issue #$n"
      fi
    done < <(grep -oE '(^|[^[:alnum:]_/-])#[0-9]+' <<<"$focus" | grep -oE '[0-9]+$' | sort -un)
    rm -f "$err"
    ((${#prs[@]} == 0)) || ng "the roadmap #$roadmap_number names pull requests in 今の焦点: ${prs[*]}"
    ((${#unknown[@]} == 0)) || ng "the roadmap #$roadmap_number names in 今の焦点 what is neither an issue nor a pull request here: ${unknown[*]}"
    if ((${#closed[@]})); then
      ng "the roadmap #$roadmap_number names closed issues in 今の焦点: ${closed[*]}"
    elif ((${#prs[@]} + ${#unknown[@]} == 0)); then
      ok "the roadmap #$roadmap_number names only open issues in 今の焦点"
    fi
  fi
fi
# Dependencies.
blocked=0
for n in $(jq -r '.[].number' <<<"$issues"); do
  by=$(gh api "repos/$repo/issues/$n/dependencies/blocked_by" --jq '[.[] | select(.state == "closed") | "#\(.number)"] | join(" ")') ||
    unreadable "the dependencies of #$n"
  if [[ -n $by ]]; then ng "#$n is blocked by closed issues: $by"; blocked=1; fi
done
((blocked)) || ok "no open issue is blocked by a closed one"

exit "$failed"
