#!/usr/bin/env bash
# PreToolUse and PostToolUse hook. Under the control plane, the agent that runs the session owns the
# work area: what it commits is what is in the work tree. A subagent (one reviewing a diff, say) that
# writes a file there or moves HEAD leaves changes the agent did not make, and they end up in its
# commits. So subagents leave the work tree, its index and HEAD alone:
# - Before a subagent's tool use, writing a file in the work tree and git commands that change it
#   are refused.
# - Around each subagent, the work tree is compared, and a change is told to the agent, as what a
#   command can write cannot all be read from it.
# A subagent's tool use carries agent_id in the hook input; the agent's own does not.
set -euo pipefail

input=$(cat)
[[ -n ${ACP_SESSION_BRANCH:-} ]] || exit 0
field() { jq -r "$1 // \"\"" <<<"$input"; }
cwd=$(field .cwd)
# The work area is the main worktree; linked ones (prctl worktree, isolation: worktree) are not it.
common=$(git -C "${CLAUDE_PROJECT_DIR:-$cwd}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
common=$(cd "$common" && pwd -P)
top=$(dirname "$common")
shopt -s extglob

# shellcheck source-path=SCRIPTDIR source=../lib/shell.sh
source "$(dirname "$0")/../lib/shell.sh"

deny() {
  jq -n --arg reason "$1" '{hookSpecificOutput: {
    hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
}

# in_area <path>: whether the path is in the work area: in its work tree (not in a linked worktree
# there) or in its .git. A path that does not exist yet is where its nearest existing directory is.
in_area() {
  local p=$1
  [[ $p == /* ]] || p=$cwd/$p
  while [[ ! -d $p ]]; do p=$(dirname "$p"); done
  p=$(cd "$p" && pwd -P)
  [[ $p == "$common" || $p == "$common"/* ]] && return 0
  [[ $(git -C "$p" rev-parse --show-toplevel 2>/dev/null) == "$top" ]]
}

# place <word> <dir>: where a directory named in a command is, relative to dir: here (in the work
# area), elsewhere, or unknown when the word is not a literal path (quoted or expanded, which
# shell_words marks with $) or dir is unknown.
place() {
  local w=$1 dir=$2
  if [[ $w == *[\$\~*?[]* || -z $w ]] || [[ $w != /* && $dir == unknown ]]; then
    echo unknown
    return
  fi
  [[ $w == /* ]] || w=$dir/$w
  if in_area "$w"; then echo here; else echo elsewhere; fi
}

# writes <dir> <subcommand> <arguments...>: whether the git subcommand, run in dir, changes the work
# tree, the index or HEAD. Its forms that only read are left out.
writes() {
  local dir=$1 sub=$2 args=" ${*:3} " out="" a
  case $sub in
    add | am | checkout | checkout-index | cherry-pick | clean | commit | merge | mv | pull | read-tree | \
      rebase | reset | restore | revert | rm | switch | update-index | update-ref) return 0 ;;
    stash) [[ $args != " "@(list|show)" "* ]] ;;
    bisect) [[ $args != " "@(log|visualize|view)" "* ]] ;;
    sparse-checkout) [[ $args != " list "* ]] ;;
    submodule) [[ $args == " "@(add|deinit|init|update|sync|absorbgitdirs)" "* ]] ;;
    apply) [[ $args != *" --"@(check|stat|numstat|summary)" "* || $args == *" --apply "* ]] ;;
    # symbolic-ref <name> <ref> sets a ref; with one name, it reads.
    symbolic-ref) [[ $args == *" -"@(d|-delete)" "* || $(wc -w <<<"${args//-[a-z-]*([^ ])/}") -ge 2 ]] ;;
    branch) [[ $args == *" "@(-m|-M|--move)" "* ]] ;;
    # format-patch writes its files to the current directory, or where -o names.
    format-patch)
      [[ $args != *" --stdout "* ]] || return 1
      set -- "${@:3}"
      while (($#)); do
        case $1 in
          -o | --output-directory) out=${2:-}; shift ;;
          --output-directory=*) out=${1#*=} ;;
        esac
        shift
      done
      a=$(place "${out:-.}" "$dir")
      [[ $a == here ]] ;;
    *) return 1 ;;
  esac
}

# changes_tree <command>: whether the command runs, in the work area, a git command that changes its
# files, its index or HEAD. A git command's place is the current directory, followed through cd, or
# what -C, --git-dir or --work-tree name. A place that cannot be read from the command (a quoted or
# expanded path) is left to the comparison around the subagent.
changes_tree() {
  local line words i dir base gd wt g w sub
  local -a saved=()
  dir=$cwd
  while IFS= read -r line; do
    # A ( ) group runs in a subshell, so a cd in it does not last.
    case $line in
      "(") saved+=("$dir"); continue ;;
      ")") ((${#saved[@]})) && { dir=${saved[-1]}; unset 'saved[-1]'; }; continue ;;
    esac
    read -ra words <<<"$line"
    ((${#words[@]})) || continue
    if [[ ${words[0]} == cd ]]; then
      w=${words[1]:-$HOME}
      if [[ $(place "$w" "$dir") == unknown ]]; then dir=unknown
      elif [[ $w == /* ]]; then dir=$w
      else dir=$dir/$w; fi
      continue
    fi
    for ((i = 0; i < ${#words[@]}; i++)); do
      [[ ${words[i]##*/} == git ]] || continue
      if [[ $dir == unknown ]]; then base=unknown; else base=$(place "$dir" /); fi
      gd="" wt="" sub=""
      for ((i++; i < ${#words[@]}; i++)); do
        case ${words[i]} in
          -C) ((i++)) || true; base=$(place "${words[i]:-}" "$dir") ;;
          --work-tree=*) wt=$(place "${words[i]#*=}" "$dir") ;;
          --work-tree) ((i++)) || true; wt=$(place "${words[i]:-}" "$dir") ;;
          --git-dir=* | --git-dir)
            g=${words[i]#--git-dir}
            g=${g#=}
            [[ -n $g ]] || { ((i++)) || true; g=${words[i]:-}; }
            gd=$(place "$g" "$dir") ;;
          -c) ((i++)) || true ;;
          -*) ;;
          *) sub=${words[i]}; break ;;
        esac
      done
      [[ -n $sub ]] || continue
      # Without --work-tree, git with --git-dir works on the current directory; without --git-dir, git
      # finds the repository from there. Either way, what is not named is where git runs.
      if [[ ${gd:-$base} == here || ${wt:-$base} == here ]]; then
        writes "$dir" "$sub" "${words[@]:i+1}" && return 0
      fi
    done
  done < <(sed -E 's/[;&|{}`]/\n/g; s/([()])/\n\1\n/g' <<<"$(shell_words "$1" '$')")
  return 1
}

# state: what a subagent must leave as it is: HEAD, the branch, the index, the stash, and each
# changed or untracked file with its content.
state() (
  cd "$top"
  export GIT_OPTIONAL_LOCKS=0
  echo "HEAD $(git rev-parse --verify --quiet HEAD || echo none)"
  echo "ブランチ $(git symbolic-ref --quiet --short HEAD || echo '(detached)')"
  echo "index $(git ls-files --stage | git hash-object --stdin)"
  echo "stash $(git rev-parse --verify --quiet refs/stash || echo none)"
  # A linked worktree inside the work area (isolation: worktree) is not its file.
  local -a linked=()
  mapfile -t linked < <(git worktree list --porcelain | sed -n "s|^worktree $top/||p")
  { git diff --name-only -z HEAD -- 2>/dev/null || true; git ls-files --others --exclude-standard -z; } \
    | sort -zu | while IFS= read -r -d '' f; do
      for w in "${linked[@]}"; do [[ $f == "$w" || $f == "$w"/* ]] && continue 2; done
      if [[ -e $f || -L $f ]]; then
        printf 'ファイル %s %s\n' "$(git hash-object --no-filters -- "$f" 2>/dev/null || echo unreadable)" "$f"
      else
        printf 'ファイル deleted %s\n' "$f"
      fi
    done
)

snapshot() { git -C "$top" rev-parse --path-format=absolute --git-path "acp-subagent-$(field .tool_use_id)"; }

event=$(field .hook_event_name)
tool=$(field .tool_name)
subagent=$(field .agent_id)
case $event:$tool in
  PreToolUse:Edit | PreToolUse:Write | PreToolUse:NotebookEdit)
    [[ -n $subagent ]] || exit 0
    path=$(field '.tool_input.file_path // .tool_input.notebook_path')
    if [[ -n $path ]] && in_area "$path"; then
      deny "control-plane 経由では、サブエージェントは作業領域のファイルを書かない（ハーネスの契約）。作業領域でコミットするのはセッションのエージェントで、サブエージェントが残したファイルはそのコミットに紛れる。試すなら作業領域の外（mktemp -d で作った場所）に書く。"
    fi
    ;;
  PreToolUse:Bash)
    [[ -n $subagent ]] || exit 0
    if changes_tree "$(field .tool_input.command)"; then
      deny "control-plane 経由では、サブエージェントは作業領域の HEAD、index、ファイルを変える git のコマンド（checkout、switch、reset、stash、add、commit など）を使わない（ハーネスの契約）。ほかのコミットを読むなら git show や git diff、ほかの PR は prctl worktree で取り出した一時的な worktree で読む。作業領域の外（mktemp -d で作った場所）で git を動かすなら、git -C <その場所> か cd <その場所> で場所を指す。"
    fi
    ;;
  PreToolUse:Agent | PreToolUse:Task)
    [[ -z $subagent ]] || exit 0
    # A snapshot whose Agent call never ended (denied by another hook, say) is left behind.
    find "$common" -maxdepth 1 -name 'acp-subagent-*' -mmin +1440 -delete 2>/dev/null || true
    state >"$(snapshot)"
    ;;
  PostToolUse:Agent | PostToolUse:Task | PostToolUseFailure:Agent | PostToolUseFailure:Task)
    [[ -z $subagent ]] || exit 0
    file=$(snapshot)
    [[ -f $file ]] || exit 0
    before=$(cat "$file")
    rm -f "$file"
    after=$(state)
    [[ $before != "$after" ]] || exit 0
    changed=$(diff <(echo "$before") <(echo "$after") | sed -n 's/^< /前：/p; s/^> /今：/p' || true)
    jq -n --arg event "$event" --arg context "サブエージェントが動いている間に、作業領域が変わった（ハーネスの契約では、サブエージェントは作業領域を変えない）。変わったもの：
$changed
自分の変更でなければ戻す。新しい追跡していないファイルは消す。追跡しているファイルは git diff で確かめてから直す（前の中身は残っていないことがある）。stage は git restore --staged、stash は git stash pop、HEAD とブランチは git switch <ブランチ> で戻す。コミットの前に git status で、入れるファイルを確かめる。" \
      '{hookSpecificOutput: {hookEventName: $event, additionalContext: $context}}'
    ;;
esac
