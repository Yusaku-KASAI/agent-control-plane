#!/usr/bin/env bash
# Tells the agent how it is run, in a few lines; the details stay in the docs it points to.
set -euo pipefail

# The docs sit beside the plugins in the marketplace. A copy of the plugin elsewhere (such as a
# plugin cache) falls back to where every target declares the marketplace.
docs=$(cd "$(dirname "$0")/../../../docs" 2>/dev/null && pwd) || docs=/workspace/agent-platform/docs
[[ -f $docs/reference/harness.md ]] || docs="（見つからない。platform の docs/）"
if [[ -n ${ACP_SESSION_BRANCH:-} ]]; then
  how="control-plane 経由
要約（詳しくはハーネスの契約）：人は端末にいない。ターンの途中で依頼者に質問して待つことはできず、ターンの最後の回答が依頼者に届く。作業はセッションのブランチ ${ACP_SESSION_BRANCH} で行う。認証情報は読み取り専用。"
else
  how="devcontainer で直接
要約（詳しくはハーネスの契約）：人は端末にいて、対話できる。"
fi
jq -n --arg event "$1" --arg ctx "# ハーネス

動き方：${how}
ハーネスの契約（渡されるもの（環境変数、作業領域、認証情報）とその制約）：${docs}/reference/harness.md
platform の文書の一覧（用語集、プラグインの構成など）：${docs}/README.md
認証、push、マウント、環境変数、ディスクの空きなどで詰まったとき、道具がエラーの文面と合わない失敗をするとき：harness スキルで切り分ける" \
  '{hookSpecificOutput: {hookEventName: $event, additionalContext: $ctx}}'
