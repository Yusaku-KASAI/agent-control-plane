#!/usr/bin/env bash
# PreToolUse hook. Under the control plane, the end of a background task comes as a notification,
# and the control plane counts the session's background tasks. A process let go from a Bash command
# (&, nohup, disown, setsid) sends no notification and is not counted, so its result is lost or
# comes in a turn of its own. Watching a task with Monitor, ScheduleWakeup or CronCreate only adds
# turns.
# Under the control plane, both are refused, pointing to run_in_background.
set -euo pipefail

input=$(cat)
[[ -n ${ACP_SESSION_BRANCH:-} ]] || exit 0

deny() {
  jq -n --arg reason "$1" '{hookSpecificOutput: {
    hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
}

# shellcheck source-path=SCRIPTDIR source=../lib/shell.sh
source "$(dirname "$0")/../lib/shell.sh"

# waits <after the last &>: whether a wait there, as a command in this shell, waits for the jobs.
# Groups in ( ) run in a subshell and are left out first, and a wait in a pipe runs in one too.
# Parameter expansions, ${...}, are one word, so that their braces are not taken for a group.
waits() {
  local rest prev=""
  # shellcheck disable=SC2016 # a sed expression
  rest=$(sed -E 's/\$\{[^}]*\}/$v/g' <<<"$1")
  while [[ $rest != "$prev" ]]; do
    prev=$rest
    rest=$(sed -E 's/\([^()]*\)/ /g' <<<"$rest")
  done
  grep -qE '(^|[;&{]|(^|[^[:alnum:]_-])(then|do|else))[[:space:]]*wait([[:space:]]+[^|;&(){}]*)?[[:space:]]*([;&}]|$)' <<<"$rest"
}

case $(jq -r .tool_name <<<"$input") in
  Bash)
    words=$(shell_words "$(jq -r '.tool_input.command // ""' <<<"$input")")
    # & as an operator, not in &&, |&, or a redirection (>&, &>, <&).
    # && and || stay as separators, so that a wait after them still reads as a command; |& becomes
    # a pipe. A wait in a pipe or in ( ) runs in a subshell and waits for nothing of this one.
    ops=$(sed -E 's/&&/;/g; s/\|\|/;/g; s/\|&/|/g; s/[0-9]*>&[0-9-]*//g; s/&>>?//g; s/[0-9]*<&[0-9-]*//g' <<<"$words")
    let_go=""
    if grep -qE '(^|[^[:alnum:]_-])(nohup|disown|setsid)([^[:alnum:]_-]|$)' <<<"$words"; then
      let_go=yes
    elif [[ $ops == *"&"* ]] && ! waits "${ops##*&}"; then
      # A job started with & and waited for after it, as a command, ends within the command.
      let_go=yes
    fi
    if [[ -n $let_go ]]; then
      deny "control-plane 経由では、処理を & や nohup、disown、setsid で手放さない（ハーネスの契約）。手放した処理は、終わりの知らせが届かず、control-plane のバックグラウンドの処理にも数えられない。終わりを待つなら Bash の run_in_background を使う。コマンドの中で済ませるなら、& のあとに wait で待つ。"
    fi
    ;;
  Monitor | ScheduleWakeup | CronCreate)
    deny "control-plane 経由では、バックグラウンドの処理の終わりは知らせで届くので、Monitor、ScheduleWakeup、CronCreate で見張ったり予約したりしない（ハーネスの契約）。見張りもターンを増やし、そのぶん回答が増える。処理は Bash の run_in_background で始め、知らせを待つ。"
    ;;
esac
