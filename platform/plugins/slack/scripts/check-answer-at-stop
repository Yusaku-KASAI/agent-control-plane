#!/usr/bin/env bash
# Stop hook: under control-plane, where the turn's last message is the answer the requester reads
# (posted to Slack for a request from Slack), finds the forms Slack's markdown block reads
# differently in it and keeps the turn going once, for the agent to rewrite them. It only checks:
# it neither rewrites the answer nor posts it. Errors of the hook itself (no jq or python3, no answer
# in the input, a state that cannot be kept) never stop the turn.
set -uo pipefail

[[ -n ${ACP_SESSION_BRANCH:-} ]] || exit 0
command -v python3 >/dev/null || exit 0
input=$(cat)
answer=$(jq -r '.last_assistant_message // empty' <<<"$input" 2>/dev/null)
[[ -n ${answer//[[:space:]]/} ]] || exit 0
session=$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)

state=${TMPDIR:-/tmp}/slack-check-answer-${session:-none}
status=0
found=$(printf '%s' "$answer" | python3 -I "$(dirname "$0")/check-markdown" 2>/dev/null) || status=$?
if ((status == 0)); then
  rm -f "$state"
  exit 0
fi
((status == 3)) || exit 0

# The same findings hold a session once until an answer passes: the agent may keep a form on
# purpose, and a turn that went on for another Stop hook is still checked. Findings that cannot be
# remembered do not hold the turn, as they would hold every end of it.
held=$(printf '%s' "$found" | cksum)
[[ $(cat "$state" 2>/dev/null) != "$held" ]] || exit 0
echo "$held" 2>/dev/null >"$state" || exit 0
jq -n --arg found "$found" '{decision: "block", reason: ("Your last message is the answer the requester reads, shown in Slack'"'"'s markdown block, which reads these forms of it differently (the slack plugin'"'"'s check-markdown; lines count from the start of the message). Rewrite them as the slack skill'"'"'s writing section tells, then end with your full answer to the request again, not only this update. If a form is meant, end with the same answer: it is checked once.\n" + $found)}'
