#!/usr/bin/env bash
# ring <count> <gap>: rings the terminal count times, gap seconds apart.
#
# In tmux, the bells are written to the attached clients' terminals in the background, so that the
# hook returns at once and the bells stay apart. Elsewhere a hook cannot reach the terminal, so
# Claude Code writes them through terminalSequence; there they arrive together.
set -uo pipefail
count=$1 gap=$2

mapfile -t ttys < <(tmux list-clients -F '#{client_tty}' 2>/dev/null | sort -u)
if ((${#ttys[@]} > 0)); then
  (
    for ((i = 0; i < count; i++)); do
      ((i == 0)) || sleep "$gap"
      for tty in "${ttys[@]}"; do printf '\a' >"$tty"; done
    done
  ) </dev/null >/dev/null 2>&1 &
  exit 0
fi

bells=
for ((i = 0; i < count; i++)); do bells+='\u0007'; done
printf '{"terminalSequence":"%s"}\n' "$bells"
