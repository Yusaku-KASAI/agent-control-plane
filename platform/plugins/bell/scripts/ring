#!/usr/bin/env bash
# ring <count> <gap>: rings the terminal count times, gap seconds apart.
#
# A hook has no terminal of its own, so the bells go to the terminal of the nearest ancestor that
# has one: the interactive Claude Code. They are written in the background, so that the hook returns
# at once. A headless agent has no such ancestor and rings nothing.
set -uo pipefail
count=$1 gap=$2

pid=$$ tty=
while [[ -n $pid && $pid != 0 && $pid != 1 ]]; do
  tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  [[ -n $tty && $tty != '?' ]] && break
  tty=''
  pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
done
[[ -n $tty ]] || exit 0

(
  for ((i = 0; i < count; i++)); do
    ((i == 0)) || sleep "$gap"
    printf '\a' >"/dev/$tty"
  done
) </dev/null >/dev/null 2>&1 &
exit 0
